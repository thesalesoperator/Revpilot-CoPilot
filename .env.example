# ============================================================
# RevPilot CoPilot Environment Configuration
# ============================================================
#
# Copy this file to .env.local and fill in the values
# cp .env.example .env.local
#
# IMPORTANT: Never commit .env.local or any file containing real secrets
# ============================================================

# ------------------------------------------------------------
# CORE CONFIGURATION
# ------------------------------------------------------------

# Next.js
NODE_ENV=development
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ------------------------------------------------------------
# SUPABASE CONFIGURATION
# ------------------------------------------------------------

# Supabase Project URL (found in Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Key (safe to expose, found in Settings > API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (KEEP SECRET - server-side only)
# Found in Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase URL alias (for scripts)
SUPABASE_URL=https://your-project.supabase.co

# ------------------------------------------------------------
# OPENAI CONFIGURATION
# ------------------------------------------------------------

# OpenAI API Key
OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI Organization ID (optional)
# OPENAI_ORG_ID=org-your-org-id

# ------------------------------------------------------------
# VAPI CONFIGURATION (AI Practice Calls)
# ------------------------------------------------------------

# Vapi API Key
VAPI_API_KEY=your-vapi-api-key-here

# Vapi Public Key (for web client)
NEXT_PUBLIC_VAPI_PUBLIC_KEY=your-vapi-public-key-here

# ------------------------------------------------------------
# DEEPGRAM CONFIGURATION (Speech-to-Text)
# ------------------------------------------------------------

# Deepgram API Key
DEEPGRAM_API_KEY=your-deepgram-api-key-here

# ------------------------------------------------------------
# UNIFIED CO-PILOT CONFIGURATION
# ------------------------------------------------------------

# Enable the unified co-pilot system
# Set to 'true' to route legacy endpoints to unified API
ENABLE_UNIFIED_COPILOT=true

# Suggestion generation interval in milliseconds
# Lower = more responsive but more API calls
# Recommended: 3000 for live coaching, 5000 for practice
COPILOT_SUGGESTION_INTERVAL=3000

# Use streaming responses from OpenAI
# Reduces perceived latency by showing partial responses
COPILOT_USE_STREAMING=true

# Use GPT-4o-mini for real-time suggestions (cost savings)
# Full GPT-4o is still used for final analysis
COPILOT_USE_MINI_MODEL=true

# ------------------------------------------------------------
# FEATURE FLAGS
# ------------------------------------------------------------

# Enable coaching tips during practice sessions
FEATURE_PRACTICE_COACHING_TIPS=true

# Enable adaptive difficulty based on user performance
FEATURE_ADAPTIVE_DIFFICULTY=true

# Enable real call analysis upload feature
FEATURE_REAL_CALL_ANALYSIS=false

# Enable script progress tracking
FEATURE_SCRIPT_PROGRESS=true

# Enable key info extraction
FEATURE_KEY_INFO_EXTRACTION=true

# Enable XP and gamification
FEATURE_GAMIFICATION=true

# Enable unified leaderboard
FEATURE_UNIFIED_LEADERBOARD=false

# ------------------------------------------------------------
# ANALYTICS & MONITORING (Optional)
# ------------------------------------------------------------

# PostHog Analytics
# NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Sentry Error Tracking
# SENTRY_DSN=https://your-sentry-dsn

# ------------------------------------------------------------
# INTEGRATION APIS (Optional)
# ------------------------------------------------------------

# Recall.ai (Bot-based recording)
# RECALL_API_KEY=your-recall-api-key

# Fathom Integration
# FATHOM_API_KEY=your-fathom-api-key

# Close CRM Integration
# CLOSE_API_KEY=your-close-api-key

# ------------------------------------------------------------
# TESTING CONFIGURATION
# ------------------------------------------------------------

# Test API base URL (for integration tests)
TEST_API_BASE=http://localhost:3000

# Test authentication token
# TEST_AUTH_TOKEN=test-token-for-ci

# ------------------------------------------------------------
# DEVELOPMENT TOOLS
# ------------------------------------------------------------

# Enable debug logging
# DEBUG=true

# Disable rate limiting in development
# DISABLE_RATE_LIMIT=true

# Mock external API calls in tests
# MOCK_EXTERNAL_APIS=true
